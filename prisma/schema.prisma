generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_DATABASE_URL")
  schemas   = ["rapperank"]
}

enum UserKind {
  ANONYMOUS
  AUTHENTICATED

  @@schema("rapperank")
}

enum ContentStatus {
  READY
  INCOMPLETE

  @@schema("rapperank")
}

enum RapperMediaType {
  image
  gif
  video

  @@schema("rapperank")
}

model User {
  id          String     @id @default(cuid())
  kind        UserKind   @default(ANONYMOUS)
  authUserId  String?    @unique @map("auth_user_id")
  displayName String?    @map("display_name")
  avatarUrl   String?    @map("avatar_url")
  sessions    Session[]
  ratings     Rating[]
  favorites   Favorite[]
  createdAt   DateTime   @default(now())
  updatedAt   DateTime   @updatedAt

  @@schema("rapperank")
}

model Session {
  id        String   @id @default(cuid())
  token     String   @unique
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now())
  expiresAt DateTime

  @@index([userId])
  @@schema("rapperank")
}

model Rapper {
  id                  String          @id @default(cuid())
  slug                String          @unique
  name                String
  chineseName         String?
  alias               String?
  region              String
  bio                 String
  shortReview         String
  avatarUrl           String?
  mediaUrl            String?
  mediaType           RapperMediaType
  backgroundAudioUrl  String?
  labels              String[]
  tags                String[]
  representativeWorks String[]
  contentStatus       ContentStatus   @default(READY)
  ratingCount         Int             @default(0)
  avgFlow             Decimal         @default(0) @db.Decimal(3, 1)
  avgLyrics           Decimal         @default(0) @db.Decimal(3, 1)
  avgVoice            Decimal         @default(0) @db.Decimal(3, 1)
  avgTechnique        Decimal         @default(0) @db.Decimal(3, 1)
  avgMelody           Decimal         @default(0) @db.Decimal(3, 1)
  avgStage            Decimal         @default(0) @db.Decimal(3, 1)
  avgPh               Decimal         @default(0) @db.Decimal(3, 1)
  overallScore        Decimal         @default(0) @db.Decimal(3, 1)
  ratings             Rating[]
  favorites           Favorite[]
  createdAt           DateTime        @default(now())
  updatedAt           DateTime        @updatedAt

  @@schema("rapperank")
}

model Rating {
  id        String   @id @default(cuid())
  userId    String
  rapperId  String
  flow      Decimal  @db.Decimal(3, 1)
  lyrics    Decimal  @db.Decimal(3, 1)
  voice     Decimal  @db.Decimal(3, 1)
  technique Decimal  @db.Decimal(3, 1)
  melody    Decimal  @db.Decimal(3, 1)
  stage     Decimal  @db.Decimal(3, 1)
  ph        Decimal  @db.Decimal(3, 1)
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  rapper    Rapper   @relation(fields: [rapperId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([userId, rapperId])
  @@index([rapperId])
  @@schema("rapperank")
}

model Favorite {
  id        String   @id @default(cuid())
  userId    String
  rapperId  String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  rapper    Rapper   @relation(fields: [rapperId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now())

  @@unique([userId, rapperId])
  @@index([rapperId])
  @@schema("rapperank")
}
